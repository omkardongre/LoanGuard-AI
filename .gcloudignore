# .gcloudignore - Controls what Cloud Build uploads
# This OVERRIDES .gitignore for Cloud Run deployments

# First, include the default .gitignore patterns
#!include:.gitignore

# THEN explicitly RE-INCLUDE models that gitignore excludes
# The ! prefix means "include even if previously excluded"
!models/
!models/**
!models/*.pkl
!models/*.json

# Exclude things we don't need in deployment
.env
.env.local
.env.*.local
.git/
.github/
.vscode/
.idea/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.DS_Store
*.log
*.tmp

# Exclude frontend (deployed separately on Vercel)
frontend/

# Exclude docs and tests (not needed in production)
self-docs/
tests/
*.md
!README.md

# Exclude secrets
.secrets/
*.pem
*.key
