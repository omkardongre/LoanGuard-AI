# LoanGuard AI Platform Environment Variables
# Copy this file to .env and fill in your API keys

# ===========================================
# Required: Google Cloud Configuration
# ===========================================

# Google API Key for Gemini LLM inference
GOOGLE_API_KEY=your_google_api_key_here

# Google Cloud Project
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=.secrets/service_account.json

# Cloud Run deployment region
CLOUD_PROJECT_REGION=us-central1

# ===========================================
# Required: BigQuery Configuration
# ===========================================

BIGQUERY_DATASET_ID=loanguard_data
BIGQUERY_LOANS_TABLE=loans
BIGQUERY_COVENANTS_TABLE=covenants
BIGQUERY_MEASUREMENTS_TABLE=covenant_measurements
BIGQUERY_ESG_TABLE=esg_kpis
BIGQUERY_ALERTS_TABLE=alerts

# ===========================================
# Required: Google Custom Search (HERO FEATURE - Greenwashing)
# ===========================================

# Google Custom Search API Key (for greenwashing detection)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here

# Google Custom Search Engine ID
# Create at: https://programmablesearchengine.google.com/
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# ===========================================
# V8 NEW: Affinda Document AI (REQUIRED)
# ===========================================

# Affinda API Key (replaces Google Document AI)
# Get from: https://app.affinda.com/ → Settings → API Keys
AFFINDA_API_KEY=your_affinda_api_key_here
AFFINDA_WORKSPACE_ID=your_workspace_id_here
AFFINDA_COLLECTION_ID=your_collection_id_here

# ===========================================
# V7: Climatiq Carbon API (RECOMMENDED)
# ===========================================

# Climatiq API Key for carbon emissions calculation
# Get from: https://www.climatiq.io/
CLIMATIQ_API_KEY=your_climatiq_api_key_here

# ===========================================
# V7: News API (RECOMMENDED)
# ===========================================

# News API Key for real-time news validation
# Get from: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# ===========================================
# Optional: External Service Integrations
# ===========================================

# SendGrid for email notifications
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=alerts@loanguard.ai

# ElevenLabs for voice calls
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_agent_id_here
ELEVENLABS_PHONE_NUMBER_ID=your_phone_number_id_here

# Slack for team notifications
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SLACK_BOT_TOKEN=your_slack_bot_token_here

# ===========================================
# Service Ports (Local Development)
# ===========================================

DOCUMENT_SERVICE_PORT=8081
COVENANT_SERVICE_PORT=8082
ESG_SERVICE_PORT=8083
ALERT_SERVICE_PORT=8084
VOICE_SERVICE_PORT=8005
UI_CLIENT_PORT=8000

# ===========================================
# Model Configuration
# ===========================================

# Gemini model for agent inference
GEMINI_MODEL=gemini-2.0-flash

# ML model paths (GCS or local)
BREACH_PREDICTOR_MODEL_PATH=models/breach_predictor.pkl
SHAP_BASE_VALUES_PATH=models/shap_base_values.json
