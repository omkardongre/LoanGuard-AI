# .gcloudignore - Controls what Cloud Build uploads
# This OVERRIDES .gitignore for Cloud Run deployments
# 
# CRITICAL: DO NOT use #!include:.gitignore as that would exclude models/*.pkl
# which are ignored in .gitignore but REQUIRED for ML functionality

# === EXPLICITLY INCLUDE ML MODELS ===
# These are excluded by .gitignore but REQUIRED for deployment
!models/
!models/**
!models/*.pkl
!models/*.json

# === EXCLUDE DEVELOPMENT FILES ===
.env
.env.local
.env.*.local
.git/
.github/
.vscode/
.idea/
__pycache__/
*.pyc
*.pyo
*.pyd
.DS_Store
*.log
*.tmp

# === EXCLUDE VIRTUAL ENVIRONMENT ===
venv/
.venv/
env/

# === EXCLUDE FRONTEND (deployed separately on Vercel) ===
frontend/
node_modules/

# === EXCLUDE DOCS AND TESTS ===
self-docs/
tests/
*.md
!README.md

# === EXCLUDE SECRETS ===
.secrets/
*.pem
*.key

# === EXCLUDE UNNECESSARY FILES ===
.dockerignore
.gitignore
.gcloudignore
Makefile
docker-compose*.yml
