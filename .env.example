# LoanGuard AI - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# GOOGLE CLOUD
# ============================================
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=loanguard-ai
GOOGLE_APPLICATION_CREDENTIALS=.secrets/service_account.json
CLOUD_PROJECT_REGION=us-central1

# ============================================
# BIGQUERY
# ============================================
BIGQUERY_DATASET_ID=loanguard_data
BIGQUERY_LOANS_TABLE=loans
BIGQUERY_COVENANTS_TABLE=covenants
BIGQUERY_MEASUREMENTS_TABLE=covenant_measurements
BIGQUERY_ESG_TABLE=esg_kpis
BIGQUERY_ALERTS_TABLE=alerts

# ============================================
# EXTERNAL APIs
# ============================================

# Google Custom Search (Greenwashing Detection)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Affinda AI (Document Parsing)
AFFINDA_API_KEY=
AFFINDA_WORKSPACE_ID=
AFFINDA_COLLECTION_ID=

# Climatiq (Carbon Calculations)
CLIMATIQ_API_KEY=

# News API (Optional - Greenwashing)
NEWS_API_KEY=

# SendGrid (Email Notifications)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@loanguard.ai

# ElevenLabs (Voice Alerts)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# FRED API (Macroeconomic Data)
FRED_API_KEY=

# Gemini (AI Risk Committee)
GEMINI_API_KEY=

# ============================================
# SERVICE CONFIGURATION
# ============================================
DOCUMENT_SERVICE_PORT=8081
COVENANT_SERVICE_PORT=8082
ESG_SERVICE_PORT=8083
ALERT_SERVICE_PORT=8084
UI_CLIENT_PORT=8000

# ============================================
# ML MODELS
# ============================================
GEMINI_MODEL=gemini-2.5-flash
BREACH_PREDICTOR_MODEL_PATH=models/breach_predictor.pkl
SHAP_BASE_VALUES_PATH=models/shap_base_values.json